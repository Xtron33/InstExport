{
  "manifestVersion": 5,
  "id": "com.xtron.instexport",
  "name": "InstExport",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } },
  "requiredPermissions": { "localFileSystem": "request" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "instexport",
      "label": { "default": "InstExport" },
      "minimumSize": { "width": 300, "height": 420 },
      "maximumSize": { "width": 1200, "height": 1600 },
      "preferredDockedSize": { "width": 340, "height": 680 },
      "preferredFloatingSize": { "width": 370, "height": 720 }
    }
  ]
}
