{
  "name": "instexport",
  "version": "0.1.0",
  "private": true,
  "description": "Photoshop UXP photo export panel",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.2",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
